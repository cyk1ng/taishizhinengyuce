# =============================================
# 配网调度业务量智能预测系统 - 环境变量配置
# =============================================
# 使用说明：
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 根据内网环境修改配置
# 3. 重启服务使配置生效

# =============================================
# 一、模型配置（三选一）
# =============================================

# 【方案 A】本地 Ollama 模型（推荐，无需外网）
# 安装：https://ollama.com/download
# 拉取模型：ollama pull qwen2.5:7b
# 启动服务：ollama serve
COZE_WORKLOAD_IDENTITY_API_KEY=ollama
COZE_INTEGRATION_MODEL_BASE_URL=http://host.docker.internal:11434/v1

# 【方案 B】云端模型（火山引擎，需要外网）
# COZE_WORKLOAD_IDENTITY_API_KEY=你的火山引擎 API_KEY
# COZE_INTEGRATION_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 【方案 C】其他本地服务（vLLM/LM Studio 等）
# COZE_WORKLOAD_IDENTITY_API_KEY=not-needed
# COZE_INTEGRATION_MODEL_BASE_URL=http://localhost:8000/v1


# =============================================
# 二、数据库配置
# =============================================

# 【生产模式】连接 Oracle 数据库
DB_TYPE=oracle
DB_HOST=10.111.134.209
DB_PORT=1521
DB_NAME=omscsdb
DB_USER=OMSCS1
DB_PASSWORD=omscs_oms123
DATABASE_URL=oracle+oracledb://OMSCS1:omscs_oms123@10.111.134.209:1521/?service_name=omscsdb

# Oracle 专用配置（oracle_db.py 使用）
ORACLE_HOST=10.111.134.209
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=omscsdb
ORACLE_USER=OMSCS1
ORACLE_PASSWORD=omscs_oms123

# 【测试模式】跳过数据库，使用假数据
# SKIP_DB=true


# =============================================
# 三、天气 API 配置（可选，需要外网）
# =============================================
# 如内网无外网，可注释掉，系统会使用假数据
WEATHER_API_KEY=44ff4071f86641979f59da2daed5505e
WEATHER_API_ENDPOINT=https://devapi.qweather.com/v7
DEFAULT_CITY=101280101


# =============================================
# 四、应用配置
# =============================================
# 服务端口（容器内固定 5000，宿主机端口在 docker-compose.yml 配置）
HOST=0.0.0.0
PORT=5000

# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 超时时间（秒）
TIMEOUT_SECONDS=600


# =============================================
# 五、模型配置文件
# =============================================
# 模型详细配置在 config/agent_llm_config.json 中
# 常用模型名称：
# - Ollama: qwen2.5:7b, llama3:8b, glm4:9b
# - 火山引擎：doubao-seed-1-8-251228
# - vLLM: Qwen/Qwen2.5-7B-Instruct


# =============================================
# 六、内网部署检查清单
# =============================================
# [ ] 1. Oracle Instant Client 文件已放到项目根目录
# [ ] 2. .env 文件已创建并配置
# [ ] 3. config/agent_llm_config.json 模型名称已修改
# [ ] 4. Ollama 服务已启动（如使用本地模型）
# [ ] 5. 数据库网络连通（ping 10.111.134.209）
# [ ] 6. Docker 服务已启动
# [ ] 7. 端口 5000 未被占用


# =============================================
# 七、快速部署命令
# =============================================
# 1. 构建镜像：docker compose build dispatch-app
# 2. 启动服务：docker compose up -d dispatch-app
# 3. 查看日志：docker compose logs -f dispatch-app
# 4. 访问系统：http://服务器 IP:5000
